filters:
  and:
    - file.inFolder("Techniques")
views:
  - type: concept-lattice
    name: Concept lattice
    order:
      - structure
      - data
      - task
      - interaction
      - file.tags
  - type: table
    name: Table
    order:
      - file.name
      - structure
      - data
      - task
      - interaction
