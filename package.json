    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "install:vault": "node scripts/install-to-vault.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
