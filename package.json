{
  "name": "lattice-bases-view",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin: a Concept lattice layout for Bases (Formal Concept Analysis over note properties).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
